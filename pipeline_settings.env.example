#Error Handling Paths
LOG_DIR="./logs"
INTUNE_CSV_PATH="./intune_devices.csv"
FAILED_DIR="./failed_uploads"

# Default values (can be overridden by environment variables)
FIRST_RUN="true"
HOURS_DEFAULT="180"

# Macmon API settings
MACMON_BASE="https://dein-macmon-server/api/v1.1/endpoints"
MACMON_USER="macmon_api"
MACMON_PASSWORD="HIER_PASSWORT_EINTRAGEN"
MACMON_PARALLEL="20"

# Optional diagnostics / resilience settings
MACMON_LOGIN_CHECK="true"
MACMON_TIMEOUT_SECONDS="20"
MACMON_SKIP_CERT_CHECK="false"

# Intune export diagnostics
INTUNE_MISSING_MAC_REPORT="false"
INTUNE_ENRICH_ETHERNET_FROM_DETAIL="true"
INTUNE_ENRICH_ETHERNET_MAX="0"

# Preflight diagnose settings
DIAG_STRESS_REQUESTS="20"
DIAG_STRESS_PARALLEL="10"
DIAG_STRESS_TIMEOUT_SECONDS="12"
DIAG_STRESS_FAIL_THRESHOLD_PCT="20"
DIAG_WARN_ETH_MISSING_PCT="90"

# Azure App Registration (Service Principal) for Microsoft Graph API access
AZURE_CLIENT_ID="HIER_CLIENT_ID_EINTRAGEN"
AZURE_TENANT_ID="HIER_TENANT_ID_EINTRAGEN"
AZURE_CLIENT_SECRET="HIER_CLIENT_SECRET_EINTRAGEN"
